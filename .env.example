# --- Application ---
APP_ENV=development
DRY_RUN=true

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# --- Frontend ---
FRONTEND_PORT=5173

# --- LLM (free tiers) ---
# Primary
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Secondary
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
# Fallback (cloud)
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2

# --- LinkedIn ---
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=

# --- Gmail / Email ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# --- Outlook email (Microsoft Graph) ---
MS_CLIENT_ID=
MS_TENANT=common
MS_TOKEN_CACHE_PATH=/app/secrets/ms_token.json
OUTLOOK_SENDER_ADDRESS=

# --- WhatsApp (owner notifications and message review) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_OWNER_NUMBER=
HOLD_WINDOW_MINUTES=10

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=connectx
POSTGRES_USER=connectx
POSTGRES_PASSWORD=

# --- Redis (APScheduler backing) ---
REDIS_URL=redis://redis:6379/0

# --- Search ---
SEARXNG_URL=http://searxng:8080

# --- Guardrails ---
LINKEDIN_DAILY_CAP=20
EMAIL_DAILY_CAP=40
SEND_WINDOW_START=10:00
SEND_WINDOW_END=17:00
SEND_WINDOW_TZ=Asia/Kolkata
MIN_TOUCH_INTERVAL_DAYS=14
DAILY_CAP_RESET_HOUR=0

# --- gspread ---
GOOGLE_SERVICE_ACCOUNT_FILE=/app/creds/gspread-service-account.json
