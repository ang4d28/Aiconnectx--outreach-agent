# --- Application ---
APP_ENV=development
DRY_RUN=true
# Sandbox: comma-separated email addresses. When set, email is sent ONLY to these; anything else is
# blocked by sandbox and the message is marked blocked. Leave empty for normal behaviour.
SEND_ALLOWLIST=

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# --- Frontend ---
FRONTEND_PORT=5173

# --- LLM (free tiers) ---
# Primary
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Secondary
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
# Fallback (cloud)
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.2

# Relative file paths below (MS_TOKEN_CACHE_PATH, LINKEDIN_PROFILE_DIR, GOOGLE_SERVICE_ACCOUNT_FILE) resolve from the
# project root; missing folders are created.
# --- LinkedIn (manual first login, session reused; no password stored) ---
LINKEDIN_PROFILE_DIR=/app/secrets/linkedin-profile
LINKEDIN_HEADLESS=true

# --- Outlook email (Microsoft Graph) ---
MS_CLIENT_ID=
MS_TENANT=common
MS_TOKEN_CACHE_PATH=/app/secrets/ms_token.json
OUTLOOK_SENDER_ADDRESS=

# --- WhatsApp (owner notifications and message review) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_OWNER_NUMBER=
HOLD_WINDOW_MINUTES=10

# --- Cloudflare Tunnel for the WhatsApp webhook (docker compose --profile tunnel up -d) ---
CLOUDFLARE_TUNNEL_TOKEN=

# Training & Placement Officer details shared with interested companies
TPO_NAME=
TPO_PHONE=
TPO_EMAIL=

# --- Dashboard accounts ---
# JWT_SECRET signs the session cookie: 32+ random characters (openssl rand -hex 32). Without it nobody can sign in.
# First admin: python -m app.cli create-admin --email you@example.com
JWT_SECRET=

# Public origins. BACKEND_URL builds the OAuth redirect URIs (register {BACKEND_URL}/api/auth/microsoft/callback with Microsoft); FRONTEND_URL is where users land after signing in.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Sign in with Microsoft (a separate app registration from MS_CLIENT_ID above, which sends mail).
# MS_AUTH_TENANT: your tenant ID to allow only your organisation; common/organizations/consumers allow others.
MS_AUTH_CLIENT_ID=
MS_AUTH_CLIENT_SECRET=
MS_AUTH_TENANT=common

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=connectx
POSTGRES_USER=connectx
POSTGRES_PASSWORD=

# --- Redis (APScheduler backing) ---
REDIS_URL=redis://redis:6379/0

# --- Search ---
SEARXNG_URL=http://searxng:8080

# --- Guardrails ---
LINKEDIN_DAILY_CAP=20
EMAIL_DAILY_CAP=40
SEND_WINDOW_START=10:00
SEND_WINDOW_END=17:00
SEND_WINDOW_TZ=Asia/Kolkata
MIN_TOUCH_INTERVAL_DAYS=14
DAILY_CAP_RESET_HOUR=0

# --- gspread ---
GOOGLE_SERVICE_ACCOUNT_FILE=/app/creds/gspread-service-account.json
GOOGLE_SHEET_ID=
